bool nube_subir(const DatosBoya_t& d) {
#if !WIFI_NUBE_ACTIVA
  return false;
#endif
  if (!wifiIntentado) nube_iniciar();
  if (wifiMulti.run() != WL_CONNECTED) return false;   // no bloquear el resto del sistema

  WiFiClientSecure client;
  // Google Apps Script usa certificados que rotan; validar la cadena
  // completa desde un ESP32 es engorroso y fragil. Por eso, igual que
  // en la mayoria de proyectos IoT con Apps Script, se omite la
  // verificacion del certificado. Es un compromiso aceptado en estos
  // proyectos porque el dato viajando (calidad de agua) no es sensible
  // como para justificar la complejidad de validar el certificado.
  client.setInsecure();

  HTTPClient http;
  http.begin(client, URL_APPS_SCRIPT);
  http.addHeader("Content-Type", "application/json");
  // Los Apps Script responden con una redireccion 302 antes de llegar
  // al contenido real: hay que decirle a HTTPClient que la siga.
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);

  String json = "{";
  json += "\"timestamp\":" + String(d.timestamp) + ",";
  json += "\"lat\":" + String(d.latitud, 6) + ",";
  json += "\"lon\":" + String(d.longitud, 6) + ",";
  json += "\"profundidad_cm\":" + String(d.profundidad_cm, 1) + ",";
  json += "\"ph\":" + String(d.ph, 2) + ",";
  json += "\"conductividad_us\":" + String(d.conductividad_us, 1) + ",";
  json += "\"od_mgL\":" + String(d.oxigeno_disuelto, 2) + ",";
  json += "\"turbidez_ntu\":" + String(d.turbidez_ntu, 1) + ",";
  json += "\"temp_c\":" + String(d.temperatura_c, 1) + ",";
  json += "\"bateria_pct\":" + String(d.bateria_pct) + ",";
  json += "\"protocolo\":" + String(d.protocolo_activo) + ",";
  json += "\"error_flags\":" + String(d.error_flags);
  json += "}";

  int codigo = http.POST(json);
  Serial.print("Google Apps Script respondio codigo: ");
  Serial.println(codigo);
  http.end();

  // Apps Script normalmente responde 200 (o 302 ya resuelto por la libreria)
  return (codigo >= 200 && codigo < 300);
}

// ======================================================================
// MODO PRUEBA - datos simulados (no toca nada del bloque ESP-NOW)
// ======================================================================
// Genera una telemetria de ejemplo con valores que varian suavemente en
// el tiempo, solo para poder ver y navegar las pantallas sin depender de
// que la Boya este encendida o configurada.
DatosBoya_t generarDatoPrueba() {
  DatosBoya_t d = {};
  float t = millis() / 1000.0f;

  // Ruido aleatorio (no solo seno) para que se vea mas "vivo" en pantalla.
  float ruidoPh    = ((float)random(-15, 16)) / 100.0f;   // +-0.15
  float ruidoCond  = (float)random(-8, 9);                // +-8
  float ruidoOd    = ((float)random(-20, 21)) / 100.0f;   // +-0.20
  float ruidoTurb  = ((float)random(-30, 31)) / 100.0f;   // +-0.30
  float ruidoTemp  = ((float)random(-25, 26)) / 100.0f;   // +-0.25
  float ruidoCol   = (float)random(-3, 4);
  float ruidoCal   = ((float)random(-50, 51)) / 100.0f;

  d.timestamp          = millis() / 1000;
  d.latitud            = 0.0f;
  d.longitud           = 0.0f;
  d.profundidad_cm     = 60.0f + 10.0f * sin(t / 5.0f) + ruidoCol;
  d.ph                 = 7.2f  + 0.3f  * sin(t / 7.0f) + ruidoPh;
  d.conductividad_us   = 350.0f + 20.0f * sin(t / 9.0f) + ruidoCond;
  d.oxigeno_disuelto   = 6.5f  + 0.5f  * sin(t / 6.0f) + ruidoOd;
  d.turbidez_ntu       = max(0.0f, 4.0f + 1.0f * sin(t / 4.0f) + ruidoTurb);
  d.temperatura_c      = 24.0f + 1.5f * sin(t / 8.0f) + ruidoTemp;
  d.bateria_pct        = 85;
  d.protocolo_activo   = PROTOCOLO_P1_AUTOMATICO;
  d.muestras_ciclo     = 1;
  // Cada ~30 s simula una alerta durante 4 s, solo para poder probar el
  // buzzer y la barra roja de alerta sin necesidad de la Boya encendida.
  d.error_flags        = (((unsigned long)t) % 30 < 4) ? 0x01 : 0;
  d.paquetes_perdidos  = 0;
  d.columna_total_cm   = 95.0f + 5.0f * sin(t / 6.0f) + ruidoCol;
  d.calado_boya_cm     = 12.0f + 2.0f * sin(t / 5.0f) + ruidoCal;
  d.pos_carro_cm       = d.profundidad_cm;
  d.estado_dispositivos = BIT_ASCENSOR_OK | BIT_BOMBA_PURGA_OK | BIT_BOMBA_MUESTREO_OK |
                           BIT_SENSOR_PH_OK | BIT_SENSOR_COND_OK | BIT_SENSOR_TURBIDEZ_OK |
                           BIT_SENSOR_TEMP_OK | BIT_US1_OK | BIT_US2_OK | BIT_US3_OK;

  // GPS simulado: avanza con pasos aleatorios (mismo criterio que el
  // simulador del Nodo Boya), para ver el trazado del lecho moverse.
  static float avanceSimulado = 0.0f;
  static unsigned long ultimoPasoGps = 0;
  if (millis() - ultimoPasoGps > 500) {
    ultimoPasoGps = millis();
    avanceSimulado += ((float)random(-20, 51)) / 100.0f;
    if (avanceSimulado < 0) avanceSimulado = 0;
  }
  d.gps_avance_m = avanceSimulado;

  // Ciclo simulado de fases (~4 s cada una), para probar los simbolos de
  // actuador activo en el plano cartesiano sin la Boya real conectada.
  uint8_t faseSimulada = (uint8_t)(((unsigned long)(t / 4.0f)) % 8);
  d.estado_fsm = faseSimulada;

  return d;
}

// ======================================================================
// PROGRAMA PRINCIPAL (setup/loop, menu)  (fuente: NodoTierra.ino)
// ======================================================================



// ---------------- Estados de la interfaz ----------------
// Secuencia obligatoria antes de poder elegir protocolo: primero se
// vincula con el Nodo 2 (Boya), luego se revisan los estados de sus
// sensores/actuadores, luego se ve la profundidad del cuerpo de agua en
// barras en vivo, y solo despues se habilita el menu de protocolos.
enum EstadoUI { UI_VINCULANDO, UI_ESTADOS, UI_BARRAS, UI_MENU, UI_CONFIG_P2, UI_ESTADO, UI_PLANO };
static EstadoUI estadoActual = UI_VINCULANDO;

// ---------------- Seleccion de protocolo (menu) ----------------
static uint8_t seleccionMenu = 0;   // 0=P1, 1=P2, 2=P3

// ---------------- Configuracion editable de P2 ----------------
static uint8_t  campoConfig = 0;          // 0=num_puntos, 1-5=cada punto, 6=muestras
static uint8_t  p2_numPuntos = 1;
static uint16_t p2_profundidades[5] = {60, 60, 60, 60, 60};  // cm, 0.6h por defecto (IDEAM)
static uint8_t  p2_muestras = 1;

// ---------------- Ultimo dato conocido de la Boya ----------------
static DatosBoya_t ultimoDato = {};
static bool hayDatoValido = false;

// ---------------- Temporizador de subida a la nube ----------------
static unsigned long ultimaSubidaNube = 0;
static const unsigned long INTERVALO_NUBE_MS = 60UL * 60UL * 1000UL; // 1 hora

void setup() {
  Serial.begin(115200);
  delay(200);
  randomSeed(analogRead(34) + millis());   // semilla real para el Modo Prueba
  Serial.println("========================================");
  Serial.println("NODO 1 -- TIERRA -- version v16 (2026-08-30)");
  Serial.println("con: plano cartesiano (lecho del rio), simbolos de");
  Serial.println("     actuador activo, Modo Prueba mas aleatorio");
  Serial.println("========================================");

  botones_iniciar();
  buzzer_iniciar();

  // Mantener OK presionado durante el encendido/reinicio para entrar
  // en Modo Prueba (telemetria simulada, sin depender de la Boya).
  delay(50);
  if (digitalRead(BTN_OK) == LOW) {
    g_modoPrueba = true;
    Serial.println("MODO PRUEBA activado (OK mantenido al encender)");
  }

  buzzer_melodia_encendido();
  pantalla_iniciar();
  pantalla_splash();

  // *** CAMBIO: el menu se muestra YA, antes de tocar SD/ESP-NOW/WiFi ***
  // Ya confirmamos (con las pruebas de relleno de color) que TODO lo
  // dibujado aqui, antes de almacenamiento_iniciar()/espnow_iniciar(),
  // SI llega correctamente a la pantalla fisica. El problema real esta
  // en los redibujados posteriores desde loop(). Mientras se investiga
  // la causa de fondo (posible interferencia de la SD o del radio
  // ESP-NOW en el bus SPI compartido), esto desbloquea el uso del menu
  // de inmediato: ya no se necesita esperar a que la Boya conecte.
  estadoActual = UI_MENU;
  pantalla_menu_protocolo(seleccionMenu);
  Serial.println("Menu de protocolos mostrado (ya no se espera a la Boya para verlo)");

  Serial.println("Iniciando microSD...");
#if SD_ACTIVA
  bool sdOk = almacenamiento_iniciar();
  if (!sdOk) Serial.println("AVISO: no se detecto microSD (revisar CS=GPIO4 y bus SPI, y que la tarjeta este formateada en FAT32)");
  else Serial.println("microSD OK");
#else
  bool sdOk = false;
  Serial.println("SD_ACTIVA=false -- se omite por completo (ni SD.begin() se llama), para "
                  "probar si la SD es la causa de que las pantallas no se actualicen");
#endif

  Serial.println("Iniciando ESP-NOW...");
  espnow_iniciar();
  Serial.println("ESP-NOW OK");

  Serial.println("Iniciando WiFi/nube...");
  nube_iniciar();   // no bloqueante; se reintenta sola en segundo plano
  Serial.println("Setup completo.");
}

void loop() {
  static uint16_t g_ultimoErrorFlags = 0;

  // ---------- 0) DIAGNOSTICO: cualquier paquete crudo recibido ----------
  // Se imprime pase o no el chequeo de tamano, para saber si el problema
  // es que no llega NADA, o que llega algo con el tamano equivocado.
  if (huboRecepcionCruda) {
    huboRecepcionCruda = false;
    Serial.printf("[ESP-NOW RX] llego un paquete de %d bytes (se esperan %d)\n",
                  ultimoLenCrudo, (int)sizeof(DatosBoya_t));
  }

  // ---------- 1) Procesar telemetria entrante de la Boya ----------
  bool llegoDatoNuevo = false;
  if (espnow_hay_datos_nuevos()) {
    ultimoDato = espnow_obtener_ultimo_dato();
    llegoDatoNuevo = true;
  }

  // ---------- 1b) Modo prueba: telemetria simulada (rama independiente) ----------
  static unsigned long ultimaSimulacion = 0;
  if (g_modoPrueba && millis() - ultimaSimulacion > 2000) {
    ultimoDato = generarDatoPrueba();
    ultimaSimulacion = millis();
    llegoDatoNuevo = true;
  }

  if (llegoDatoNuevo) {
    bool esPrimerDato = !hayDatoValido;
    hayDatoValido = true;
    almacenamiento_guardar(ultimoDato);
    if (ultimoDato.error_flags != 0 && g_ultimoErrorFlags == 0) {
      buzzer_melodia_alerta();
    }
    g_ultimoErrorFlags = ultimoDato.error_flags;

    // Primer paquete recibido (real o simulado) -> el Nodo 2 ya esta
    // vinculado. Antes esto dependia de estar en la pantalla UI_VINCULANDO,
    // pero desde que el menu aparece de inmediato al encender, esa pantalla
    // casi nunca se visita -- por eso el buzzer nunca sonaba. Ahora suena
    // sin importar en que pantalla este el usuario.
    if (esPrimerDato) {
      Serial.println("[UI] Primer dato real recibido de la Boya -- enlace confirmado");
      buzzer_melodia_vinculado();
      if (estadoActual == UI_VINCULANDO) {
        estadoActual = UI_ESTADOS;
      }
    }

    if (estadoActual == UI_ESTADO) {
      pantalla_estado(ultimoDato, espnow_enlace_activo() || g_modoPrueba, almacenamiento_ok());
    } else if (estadoActual == UI_ESTADOS) {
      pantalla_estados_dispositivos(ultimoDato);
    } else if (estadoActual == UI_BARRAS) {
      pantalla_barras(ultimoDato);
    } else if (estadoActual == UI_PLANO) {
      pantalla_plano_cartesiano(ultimoDato);
    }
  }

  // ---------- 1c) Animacion de puntos suspensivos mientras falten datos ----------
  // Deteccion de perdida de enlace (transicion conectado -> no conectado):
  // solo aplica una vez que ya hubo vinculacion real (no en el arranque).
  static bool g_enlaceEstabaActivo = false;
  if (hayDatoValido) {
    bool enlaceAhora = espnow_enlace_activo() || g_modoPrueba;
    if (g_enlaceEstabaActivo && !enlaceAhora) {
      buzzer_melodia_sin_conexion();
    }
    g_enlaceEstabaActivo = enlaceAhora;
  }
  // Redibuja periodicamente SOLO si hay algo que animar, para no gastar
  // tiempo de CPU redibujando pantallas que ya estan completas y quietas.
  static unsigned long ultimoTickAnimacion = 0;
  if (millis() - ultimoTickAnimacion > 300) {
    ultimoTickAnimacion = millis();
    if (estadoActual == UI_VINCULANDO) {
      pantalla_vinculando();
    } else if (estadoActual == UI_ESTADO && hayDatoValido) {
      uint16_t sensoresEsperados = BIT_SENSOR_PH_OK | BIT_SENSOR_COND_OK |
                                    BIT_SENSOR_TURBIDEZ_OK | BIT_SENSOR_TEMP_OK;
      bool faltaAlguno = (ultimoDato.estado_dispositivos & sensoresEsperados) != sensoresEsperados;
      if (faltaAlguno) {
        pantalla_estado(ultimoDato, espnow_enlace_activo() || g_modoPrueba, almacenamiento_ok());
      }
    }
  }

  // ---------- 2) Subida periodica a la nube (no bloqueante) ----------
  if (hayDatoValido && millis() - ultimaSubidaNube > INTERVALO_NUBE_MS) {
    if (nube_subir(ultimoDato)) {
      Serial.println("Subida a la nube OK");
    } else {
      Serial.println("Subida a la nube fallo (se reintenta en el proximo ciclo)");
    }
    ultimaSubidaNube = millis();
  }

  // ---------- 3) Leer botones y actualizar la maquina de estados ----------
  Boton b = botones_leer();
  if (b == BOTON_NINGUNO) return;
  buzzer_clic();

  switch (estadoActual) {

    case UI_VINCULANDO:
      // BACK = atajo manual para banco de pruebas sin la Boya encendida
      if (b == BOTON_ATRAS) {
        estadoActual = UI_MENU;
        pantalla_menu_protocolo(seleccionMenu);
      }
      break;

    case UI_ESTADOS:
      if (b == BOTON_OK || b == BOTON_ATRAS) {
        estadoActual = UI_BARRAS;
        pantalla_barras(hayDatoValido ? ultimoDato : DatosBoya_t{});
      }
      break;

    case UI_BARRAS:
      // Solo se puede pasar al menu de protocolos si ya se tiene una
      // lectura de la profundidad del cuerpo de agua (columna_total_cm).
      if (b == BOTON_OK) {
        if (hayDatoValido && ultimoDato.columna_total_cm > 0.0f) {
          estadoActual = UI_MENU;
          pantalla_menu_protocolo(seleccionMenu);
        } else {
          pantalla_mensaje("Esperando medicion", "de profundidad...");
          delay(1000);
          pantalla_barras(hayDatoValido ? ultimoDato : DatosBoya_t{});
        }
      }
      if (b == BOTON_ATRAS) {
        estadoActual = UI_ESTADOS;
        pantalla_estados_dispositivos(hayDatoValido ? ultimoDato : DatosBoya_t{});
      }
      break;

    case UI_MENU:
      if (b == BOTON_ARRIBA) seleccionMenu = (seleccionMenu == 0) ? 2 : seleccionMenu - 1;
      if (b == BOTON_ABAJO)  seleccionMenu = (seleccionMenu == 2) ? 0 : seleccionMenu + 1;
      // ---- DIAGNOSTICO TEMPORAL: quitar cuando ya funcione ----
      Serial.printf("[MENU] seleccionMenu=%d (0=P1,1=P2,2=P3)\n", seleccionMenu);
      if (b == BOTON_OK) {
        if (seleccionMenu == 1) {           // P2 -> ir a configuracion
          campoConfig = 0;
          estadoActual = UI_CONFIG_P2;
          pantalla_config_p2(campoConfig, p2_numPuntos, p2_profundidades, p2_muestras);
          return;
        } else {                            // P1 o P3 -> enviar directo, sin configuracion
          ComandoTierra_t cmd = {};
          cmd.comando = 1;
          cmd.protocolo_nuevo = (seleccionMenu == 0) ? PROTOCOLO_P1_AUTOMATICO : PROTOCOLO_P3_REACTIVO;
          bool enviado = espnow_enviar_comando(cmd);
          pantalla_mensaje(enviado ? "Protocolo enviado" : "Error al enviar",
                            enviado ? "a la Boya" : "revisar enlace ESP-NOW");
          delay(1200);
          estadoActual = UI_ESTADO;
          pantalla_estado(ultimoDato, espnow_enlace_activo(), almacenamiento_ok());
          return;
        }
      }
      if (b == BOTON_ATRAS) {               // atajo: ver ultimo estado conocido
        estadoActual = UI_ESTADO;
        pantalla_estado(ultimoDato, espnow_enlace_activo(), almacenamiento_ok());
        return;
      }
      pantalla_menu_protocolo(seleccionMenu);
      break;

    case UI_CONFIG_P2:
      if (b == BOTON_ATRAS) {               // cancelar, no se envia nada
        estadoActual = UI_MENU;
        pantalla_menu_protocolo(seleccionMenu);
        return;
      }
      if (b == BOTON_ARRIBA || b == BOTON_ABAJO) {
        int delta = (b == BOTON_ARRIBA) ? 1 : -1;
        if (campoConfig == 0) {
          p2_numPuntos = constrain((int)p2_numPuntos + delta, 1, 5);
        } else if (campoConfig >= 1 && campoConfig <= 5) {
          uint8_t idx = campoConfig - 1;
          // Rango 0-120 cm en pasos de 5, alineado al recorrido fisico del Ascensor
          int nuevo = (int)p2_profundidades[idx] + delta * 5;
          p2_profundidades[idx] = constrain(nuevo, 0, 120);
        } else if (campoConfig == 6) {
          p2_muestras = constrain((int)p2_muestras + delta, 1, 5);
        }
      }
      if (b == BOTON_OK) {
        if (campoConfig < p2_numPuntos) {
          campoConfig++;                    // pasar al siguiente punto de profundidad
        } else if (campoConfig < 6) {
          campoConfig = 6;                  // saltar directo a "muestras por ciclo"
        } else {
          // ultimo campo confirmado -> armar y enviar el comando completo
          ComandoTierra_t cmd = {};
          cmd.comando = 1;
          cmd.protocolo_nuevo = PROTOCOLO_P2_CONFIGURABLE;
          cmd.num_puntos_prof = p2_numPuntos;
          for (uint8_t i = 0; i < p2_numPuntos; i++) cmd.profundidades_cm[i] = p2_profundidades[i];
          cmd.muestras_por_ciclo = p2_muestras;

          bool enviado = espnow_enviar_comando(cmd);
          pantalla_mensaje(enviado ? "Config. P2 enviada" : "Error al enviar",
                            enviado ? "a la Boya" : "revisar enlace ESP-NOW");
          delay(1200);
          estadoActual = UI_ESTADO;
          pantalla_estado(ultimoDato, espnow_enlace_activo(), almacenamiento_ok());
          return;
        }
      }
      pantalla_config_p2(campoConfig, p2_numPuntos, p2_profundidades, p2_muestras);
      break;

    case UI_ESTADO:
      if (b == BOTON_ATRAS) {
        estadoActual = UI_MENU;
        pantalla_menu_protocolo(seleccionMenu);
        return;
      }
      if (b == BOTON_OK) {
        estadoActual = UI_PLANO;
        pantalla_plano_cartesiano(hayDatoValido ? ultimoDato : DatosBoya_t{});
        return;
      }
      // UP/DOWN en esta pantalla no hacen nada por ahora (reservado a futuro,
      // por ejemplo para desplazarse entre varias lecturas historicas)
      break;

    case UI_PLANO:
      if (b == BOTON_ATRAS) {
        estadoActual = UI_MENU;
        pantalla_menu_protocolo(seleccionMenu);
        return;
      }
      if (b == BOTON_OK) {
        estadoActual = UI_ESTADO;
        pantalla_estado(ultimoDato, espnow_enlace_activo() || g_modoPrueba, almacenamiento_ok());
        return;
      }
      break;
  }
}

