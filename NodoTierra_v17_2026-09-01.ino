// COMUNICACION ESP-NOW CON LA BOYA  (fuente: comunicacion_boya.cpp)
// ======================================================================


static DatosBoya_t datoInternoBoya;
static volatile bool datoNuevo = false;
static unsigned long ultimoDatoMillis = 0;
static volatile int ultimoLenCrudo = -1;      // *** DIAGNOSTICO: tamano de CUALQUIER
static volatile bool huboRecepcionCruda = false;  // paquete recibido, coincida o no el tamano esperado

static void procesarDatoRecibido(const uint8_t* data, int len) {
  ultimoLenCrudo = len;
  huboRecepcionCruda = true;
  if (len == sizeof(DatosBoya_t)) {
    memcpy((void*)&datoInternoBoya, data, sizeof(DatosBoya_t));
    datoNuevo = true;
    ultimoDatoMillis = millis();
  }
}

// --- callback de recepcion (se ejecuta en interrupcion, mantener corto) ---
#if ESP_IDF_VERSION_MAJOR >= 5
// Core ESP32 3.x (Arduino IDE reciente)
void IRAM_ATTR onDatoRecibido(const esp_now_recv_info_t* info, const uint8_t* data, int len) {
  procesarDatoRecibido(data, len);
}
#else
// Core ESP32 2.x
void IRAM_ATTR onDatoRecibido(const uint8_t* mac, const uint8_t* data, int len) {
  procesarDatoRecibido(data, len);
}
#endif

void espnow_iniciar() {
  WiFi.mode(WIFI_STA);
  delay(100);   // margen para que el radio Wi-Fi termine de levantar antes de leer la MAC
  Serial.print("MAC de este Tierra: ");
  Serial.println(WiFi.macAddress());

  if (esp_now_init() != ESP_OK) {
    Serial.println("ERROR: no se pudo iniciar ESP-NOW");
    return;
  }
  esp_now_register_recv_cb(onDatoRecibido);

  esp_now_peer_info_t peer = {};
  memcpy(peer.peer_addr, MAC_NODO_BOYA, 6);
  peer.channel = 0;      // 0 = usar el canal WiFi actual
  peer.encrypt = false;
  if (!esp_now_is_peer_exist(MAC_NODO_BOYA)) {
    esp_err_t r = esp_now_add_peer(&peer);
    Serial.print("esp_now_add_peer (Boya) resultado: ");
    Serial.println(r == ESP_OK ? "OK" : "ERROR");
  }
  Serial.println("ESP-NOW OK. Esperando paquetes de la Boya...");
}

bool espnow_enviar_comando(const ComandoTierra_t& cmd) {
  esp_err_t r = esp_now_send(MAC_NODO_BOYA, (const uint8_t*)&cmd, sizeof(cmd));
  return r == ESP_OK;
}

bool espnow_hay_datos_nuevos() {
  if (datoNuevo) {
    datoNuevo = false;
    return true;
  }
  return false;
}

DatosBoya_t espnow_obtener_ultimo_dato() {
  return datoInternoBoya;
}

bool espnow_enlace_activo() {
  // RF-CN-02: si no llega nada en mas de 2 minutos, se asume enlace caido
  // (los datos siguen a salvo en la microSD local de la Boya).
  return (millis() - ultimoDatoMillis) < (2UL * 60UL * 1000UL);
}

