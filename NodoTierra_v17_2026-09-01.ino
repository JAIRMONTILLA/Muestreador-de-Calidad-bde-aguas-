static const char* NOMBRE_PROTOCOLO[3] = {
  "P1 Automatico",
  "P2 Configurable",
  "P3 Reactivo",
};

void pantalla_iniciar() {
  // El bus SPI (SCK=18, MOSI=23) ya debe estar inicializado por SD.begin()
  // en almacenamiento.cpp ANTES de llamar a esta funcion, o se inicializa
  // aqui mismo si la SD se inicia despues. Ver orden en NodoTierra.ino.
  tft.initR(INITR_BLACKTAB);      // ajustar a INITR_GREENTAB si los colores salen invertidos
  tft.setRotation(0);             // vertical, 128x160 (orientacion natural del panel)
  tft.fillScreen(COLOR_FONDO);
  tft.setTextWrap(false);
}

// Dibuja un escudo (56x56, RGB565) comprimido horizontalmente a
// 'anchoDestino' pixeles, centrado. anchoDestino va de 0 a LOGO_LADO
// y decreciendo/creciendo en el tiempo simula el giro de una moneda
// sobre su eje vertical.
void dibujarEscudoEscalado(const uint16_t* bitmap, int anchoDestino) {
  if (anchoDestino <= 0) return;
  int x0 = (PANTALLA_ANCHO - anchoDestino) / 2;
  int y0 = 52;
  for (int yy = 0; yy < LOGO_LADO; yy++) {
    for (int xxDest = 0; xxDest < anchoDestino; xxDest++) {
      int xxSrc = (xxDest * LOGO_LADO) / anchoDestino;
      uint16_t color = pgm_read_word(&bitmap[yy * LOGO_LADO + xxSrc]);
      tft.drawPixel(x0 + xxDest, y0 + yy, color);
    }
  }
}

// Pantalla de inicio: titulo, "Nodo Tierra", escudos estaticos en secuencia
// (Universidad Libre 5 s, luego Ingenieria Industrial) y credito. Cualquier
// boton salta la secuencia de inmediato, para no bloquear el uso del
// resto del dispositivo mientras se gestiona el modulo Boya.
void pantalla_splash() {
  tft.fillScreen(COLOR_FONDO);

  tft.setTextSize(1);
  tft.setTextColor(COLOR_ACENTO);
  tft.setCursor(4, 2);
  tft.print("Muestreador de");
  tft.setCursor(4, 10);
  tft.print("Calidad de Aguas");

  tft.setTextSize(2);
  tft.setTextColor(COLOR_TEXTO);
  tft.setCursor(4, 20);
  tft.print("Nodo");
  tft.setCursor(4, 36);
  tft.print("Tierra");

  // Insignia de Modo Prueba como badge en la esquina, para no quitarle
  // espacio vertical al logo (que ahora es mucho mas grande).
  if (g_modoPrueba) {
    tft.fillRect(84, 0, 44, 10, COLOR_ALERTA);
    tft.setTextColor(COLOR_TEXTO);
    tft.setCursor(86, 1);
    tft.print("PRUEBA");
  }

  tft.setTextSize(1);
  tft.setTextColor(COLOR_TEXTO);
  tft.setCursor(4, 140);
  tft.print("Hecho por");
  tft.setCursor(4, 150);
  tft.print("Ing. Jair E.");

  // --- Escudos estaticos (sin giro): primero Universidad Libre 5 s,
  //     despues Ingenieria Industrial. Cualquier boton salta todo. ---
  tft.fillRect(0, 52, PANTALLA_ANCHO, LOGO_LADO, COLOR_FONDO);
  dibujarEscudoEscalado(logo_universidad_libre, LOGO_LADO);
  unsigned long t0 = millis();
  while (millis() - t0 < 5000) {
    if (botones_leer() != BOTON_NINGUNO) return;   // salta toda la intro
  }

  tft.fillRect(0, 52, PANTALLA_ANCHO, LOGO_LADO, COLOR_FONDO);
  dibujarEscudoEscalado(logo_ingenieria_industrial, LOGO_LADO);
  unsigned long t1 = millis();
  while (millis() - t1 < 3000) {
    if (botones_leer() != BOTON_NINGUNO) return;
  }
}

