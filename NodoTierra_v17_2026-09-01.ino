// ======================================================================
// MAPA DE PINES  (fuente: pines.h)
// ======================================================================


// ---------- Pantalla TFT 1.8" 128x160 (driver ST7735) ----------
#define TFT_CS    21   // C20 -> F13  (verde)
#define TFT_DC    22   // C23 -> F12  (cafe)
#define TFT_RST    5   // C17 -> F11  (naranja)
#define TFT_SCK   18   // C18 -> F9   (azul, bus compartido)
#define TFT_MOSI  23   // C24 -> F10  (morado, bus compartido)
// BL (backlight) va cableado directo a 3.3V - no usa GPIO

// ---------- microSD (adaptador 6 pines) ----------
#define SD_CS     4    // C14 -> F28  (verde)
#define SD_SCK    18   // C18 -> F27  (azul, bus compartido con TFT)
#define SD_MOSI   23   // C24 -> F26  (morado, bus compartido con TFT)
#define SD_MISO   19   // C19 -> F25  (amarillo, exclusivo de la SD)

// ---------- Botones (fila derecha, VIN...EN) ----------
#define BTN_UP    13   // D13 - navegar arriba / incrementar valor
#define BTN_DOWN  12   // D12 - navegar abajo / decrementar valor
#define BTN_OK    14   // D14 - confirmar / entrar al submenu
#define BTN_BACK  27   // D27 - atras / cancelar

// ---------- Buzzer (alertas / encendido) ----------
#define PIN_BUZZER 26  // GPIO libre, mismo lado fisico que los botones
                       // (pegado a BTN_BACK=27), para no cruzar cableado
                       // hacia el lado de la pantalla/SD.
                       // Si el buzzer consume mas de ~20 mA, no conectarlo
                       // directo al GPIO: usar un transistor NPN (BC547)
                       // como driver, igual que los reles del Nodo Boya.
#define BUZZER_CLIC_BOTONES true  // true = bip corto en cada boton valido

// ---------- Reservados / no usar en este firmware ----------
// GPIO15, GPIO2  -> libres (reserva futura)
// GPIO16 (RX2), GPIO17 (TX2) -> libres (reserva futura)
// GPIO3 (RX0), GPIO1 (TX0)   -> UART0, exclusivos del USB, NO tocar

// ---------- Parametros generales ----------
#define DEBOUNCE_MS       180   // antirrebote por software para los 4 botones
#define PANTALLA_ANCHO    128   // vertical (portrait): ancho menor que el alto
#define PANTALLA_ALTO     160

// ---------- Modo prueba (usar el Nodo Tierra solo, sin la Boya) ----------
// Mantener presionado BTN_OK mientras se enciende/reinicia la placa para
// entrar en este modo. Genera telemetria simulada localmente para poder
// probar pantallas, menus y botones mientras se termina de configurar
// el Nodo Boya. No modifica nada del bloque ESP-NOW: la logica real de
// enlace, envio y recepcion sigue exactamente igual.
static bool g_modoPrueba = false;

// ======================================================================
// ESTRUCTURAS COMPARTIDAS (Nodo Tierra <-> Nodo Boya)  (fuente: comun.h)
// ======================================================================


// Protocolos de muestreo (deben coincidir con el firmware de la Boya)
enum Protocolo : uint8_t {
  PROTOCOLO_P1_AUTOMATICO   = 1,  // por tiempo y profundidad variable
  PROTOCOLO_P2_CONFIGURABLE = 2,  // definido por el investigador
  PROTOCOLO_P3_REACTIVO     = 3,  // disparado por umbrales
};

// Banderas de error / estado (bit a bit)
#define ERR_BATERIA_BAJA     (1 << 0)
#define ERR_SENSOR_PH        (1 << 1)
#define ERR_SENSOR_OD        (1 << 2)
#define ERR_SENSOR_COND      (1 << 3)
#define ERR_SENSOR_TURBIDEZ  (1 << 4)
#define ERR_ASCENSOR_ATASCO  (1 << 5)
#define ERR_ESPNOW_PERDIDA   (1 << 6)

// ---- Bitmask de estado_dispositivos: 1=OK/conectado, 0=falla o no verificado ----
// (debe coincidir exactamente con NodoBoya_TodoEnUno.ino)
#define BIT_ASCENSOR_OK        (1 << 0)
#define BIT_BOMBA_PURGA_OK     (1 << 1)
#define BIT_BOMBA_MUESTREO_OK  (1 << 2)
#define BIT_SENSOR_PH_OK       (1 << 3)
#define BIT_SENSOR_COND_OK     (1 << 4)
#define BIT_SENSOR_TURBIDEZ_OK (1 << 5)
#define BIT_SENSOR_TEMP_OK     (1 << 6)
#define BIT_US1_OK              (1 << 7)   // columna total
#define BIT_US2_OK              (1 << 8)   // calado boya
#define BIT_US3_OK              (1 << 9)   // posicion carro

// Fase actual de la FSM de la Boya (campo estado_fsm) -- debe coincidir
// exactamente con el orden del enum EstadoBoya en NodoBoya_TodoEnUno.ino
#define ESTADO_FSM_MEDIR_COLUMNA     0
#define ESTADO_FSM_BAJAR             1
#define ESTADO_FSM_ESTABILIZAR       2
#define ESTADO_FSM_LEER_SONDA        3
#define ESTADO_FSM_PURGAR            4
#define ESTADO_FSM_LLENAR_RECIPIENTE 5
#define ESTADO_FSM_SUBIR_HOME        6
#define ESTADO_FSM_REGISTRAR_ENVIAR  7
#define ESTADO_FSM_ERROR             8

// ---------- Telemetria que envia la Boya al Nodo Tierra ----------
// IMPORTANTE: debe coincidir byte a byte con DatosBoya_t en
// NodoBoya_TodoEnUno.ino, incluyendo el orden de los campos.
typedef struct __attribute__((packed)) {
  uint32_t timestamp;        // epoch (segundos)
  float    latitud;
  float    longitud;
  float    profundidad_cm;
  float    ph;
  float    conductividad_us; // µS/cm
  float    oxigeno_disuelto; // mg/L (sensor no instalado todavia, siempre 0)
  float    turbidez_ntu;
  float    temperatura_c;
  uint8_t  bateria_pct;      // 0-100 (banco de pruebas: fijo en 100)
  uint8_t  protocolo_activo; // ver enum Protocolo
  uint8_t  muestras_ciclo;   // cuantas pasadas se hicieron al recipiente
  uint16_t error_flags;      // ver ERR_*
  uint16_t paquetes_perdidos;// contador para verificar RNF-03 (<5% a 50 m)
  // ---- Campos v2 (agregados al final, ver NodoBoya_TodoEnUno.ino) ----
  float    columna_total_cm; // US1: profundidad total del cuerpo de agua
  float    calado_boya_cm;   // US2: calado de la boya
  float    pos_carro_cm;     // US3: posicion del carro del ascensor
  uint16_t estado_dispositivos; // bitmask BIT_*
  // ---- Campos v3 (trazado del lecho / plano cartesiano) ----
  float    gps_avance_m;     // avance horizontal (metros) -- simulado hasta
                              // que se instale el modulo GPS real
  uint8_t  estado_fsm;       // fase actual del ciclo en la Boya (ver FSM_* )
} DatosBoya_t;

// ---------- Comando que el Nodo Tierra envia a la Boya ----------
typedef struct __attribute__((packed)) {
  uint8_t  comando;           // 1=cambiar protocolo, 2=iniciar ciclo manual
  uint8_t  protocolo_nuevo;   // Protocolo deseado (si comando==1)
  uint8_t  num_puntos_prof;   // P2: cuantos puntos de profundidad (1-5)
  uint16_t profundidades_cm[5]; // P2: hasta 5 profundidades en cm
  uint8_t  muestras_por_ciclo;// P2: 1-5 frascos por ciclo
} ComandoTierra_t;

