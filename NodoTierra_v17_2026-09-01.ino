// Barras verticales delgadas de colores distintos, en vivo, para los 3
// sensores ultrasonicos y los 4 parametros de la sonda.
void pantalla_barras(const DatosBoya_t& datos) {
  tft.fillScreen(COLOR_FONDO);
  tft.setTextSize(1);
  tft.setTextColor(COLOR_ACENTO);
  tft.setCursor(4, 2);
  tft.print("Nodo 2: lecturas");
  tft.drawFastHLine(0, 12, PANTALLA_ANCHO, COLOR_ACENTO);

  // Cada barra: {valor, max_esperado, color, etiqueta}
  struct { float valor; float maxEsperado; uint16_t color; const char* etiqueta; } barras[] = {
    {datos.columna_total_cm, 200.0f, ST77XX_CYAN,   "COL"},
    {datos.calado_boya_cm,    50.0f, ST77XX_BLUE,   "CAL"},
    {datos.pos_carro_cm,     120.0f, ST77XX_WHITE,  "CAR"},
    {datos.ph,                14.0f, ST77XX_GREEN,  "PH"},
    {datos.conductividad_us,1000.0f, ST77XX_YELLOW, "COND"},
    {datos.turbidez_ntu,     100.0f, 0xFD20,         "TURB"},  // naranja (RGB565 directo)
    {datos.temperatura_c,     40.0f, ST77XX_RED,    "TEMP"},
  };
  const int nBarras = 7;
  const int anchoBarra = 12;
  const int espacio = 6;
  const int yBase = 130;      // linea base de las barras
  const int alturaMax = 100;  // alto maximo de una barra llena

  int x = 4;
  for (int i = 0; i < nBarras; i++) {
    float frac = barras[i].valor / barras[i].maxEsperado;
    frac = constrain(frac, 0.0f, 1.0f);
    int alto = (int)(frac * alturaMax);

    tft.drawRect(x, yBase - alturaMax, anchoBarra, alturaMax, COLOR_ACENTO);
    tft.fillRect(x, yBase - alto, anchoBarra, alto, barras[i].color);

    tft.setTextColor(COLOR_TEXTO);
    tft.setCursor(x - 1, yBase + 2);
    tft.print(barras[i].etiqueta);

    x += anchoBarra + espacio;
  }

  tft.setTextColor(COLOR_ACENTO);
  tft.setCursor(4, 150);
  tft.print("OK = elegir protocolo");
}

// ======================================================================
// PLANO CARTESIANO -- trazado del lecho del rio
// Eje X = avance horizontal (GPS, simulado hasta instalar el modulo real)
// Eje Y = profundidad. Y=0 es la linea de flotabilidad (superficie);
// hacia abajo en pantalla = profundidad positiva creciente (visualmente
// equivale a "Y negativo" en el sentido matematico que se pidio).
// ======================================================================
// TRAZA_MAX_PUNTOS controla cuanto tiempo/distancia cubre el trazado
// antes de empezar a descartar los puntos mas viejos (buffer circular).
// Ejemplo: con el filtro de 0.15 m entre puntos (mas abajo), 100 puntos
// cubren ~15 m de recorrido. Si la Boya avanza ~0.25 m/s, eso equivale
// a ~60 s de historial visible. Sube este numero si necesitas cubrir mas
// tiempo/distancia (cada punto ocupa 8 bytes, hay memoria de sobra).
#define TRAZA_MAX_PUNTOS 100
struct PuntoTraza { float x_m; float prof_cm; };
static PuntoTraza g_traza[TRAZA_MAX_PUNTOS];
static uint8_t g_trazaCount = 0;
static uint8_t g_trazaInicio = 0;
static float g_ultimoXRegistrado = -999.0f;

// Suavizado tipo Chaikin (una pasada, "corte de esquinas"): convierte una
// polilinea de segmentos rectos en una curva mas redondeada, sin necesitar
// splines completos -- barato en CPU y memoria para un microcontrolador.
struct PtoPix { int16_t x; int16_t y; };

int suavizarChaikin(PtoPix* origen, int n, PtoPix* destino) {
  if (n < 3) {
    for (int i = 0; i < n; i++) destino[i] = origen[i];
    return n;
  }
  int m = 0;
  destino[m++] = origen[0];
  for (int i = 0; i < n - 1; i++) {
    PtoPix a = origen[i], b = origen[i + 1];
    destino[m++] = { (int16_t)(a.x + (b.x - a.x) * 0.25f), (int16_t)(a.y + (b.y - a.y) * 0.25f) };
    destino[m++] = { (int16_t)(a.x + (b.x - a.x) * 0.75f), (int16_t)(a.y + (b.y - a.y) * 0.75f) };
  }
  destino[m++] = origen[n - 1];
  return m;
}

void trazaAgregarPunto(float x_m, float prof_cm) {
  // Filtra puntos demasiado seguidos, para no saturar el buffer mientras
  // la Boya practicamente no se mueve.
  if (g_trazaCount > 0 && fabs(x_m - g_ultimoXRegistrado) < 0.15f) return;
  g_ultimoXRegistrado = x_m;
  uint8_t idx = (g_trazaInicio + g_trazaCount) % TRAZA_MAX_PUNTOS;
  if (g_trazaCount < TRAZA_MAX_PUNTOS) {
    g_traza[idx].x_m = x_m;
    g_traza[idx].prof_cm = prof_cm;
    g_trazaCount++;
  } else {
    g_traza[g_trazaInicio].x_m = x_m;
    g_traza[g_trazaInicio].prof_cm = prof_cm;
    g_trazaInicio = (g_trazaInicio + 1) % TRAZA_MAX_PUNTOS;
  }
}

const char* nombreFaseFsm(uint8_t fase) {
  switch (fase) {
    case ESTADO_FSM_MEDIR_COLUMNA:     return "Midiendo columna";
    case ESTADO_FSM_BAJAR:             return "Ascensor bajando";
    case ESTADO_FSM_ESTABILIZAR:       return "Estabilizando";
    case ESTADO_FSM_LEER_SONDA:        return "Sonda midiendo";
    case ESTADO_FSM_PURGAR:            return "Purgando";
    case ESTADO_FSM_LLENAR_RECIPIENTE: return "Tomando muestra";
    case ESTADO_FSM_SUBIR_HOME:        return "Ascensor subiendo";
    case ESTADO_FSM_REGISTRAR_ENVIAR:  return "Registrando datos";
    default:                           return "Error";
  }
}

void pantalla_plano_cartesiano(const DatosBoya_t& datos) {
  tft.fillScreen(COLOR_FONDO);
  tft.setTextSize(1);
  tft.setTextColor(COLOR_ACENTO);
  tft.setCursor(2, 2);
  tft.print("Lecho del rio (Nodo 2)");
  tft.setTextColor(ST77XX_YELLOW);
  tft.setCursor(2, 12);
  tft.print("Avance GPS: ");
  tft.print(datos.gps_avance_m, 1);
  tft.print(" m");

  // Registrar el punto actual del lecho (US1) en la traza
  if (datos.estado_dispositivos & BIT_US1_OK) {
    trazaAgregarPunto(datos.gps_avance_m, datos.columna_total_cm);
  }

  const int plotX0 = 24, plotX1 = PANTALLA_ANCHO - 4;
  const int y0 = 26;      // linea de flotabilidad (Y=0)
  const int yMax = 104;   // limite inferior del area de dibujo (deja espacio a las etiquetas X debajo)
  const float PX_POR_CM = 0.5f;

  // Eje Y=0 -- linea de flotabilidad
  tft.drawFastHLine(plotX0, y0, plotX1 - plotX0, COLOR_TEXTO);
  tft.setTextColor(COLOR_TEXTO);
  tft.setCursor(plotX0, y0 - 9);
  tft.print("Y=0 (flotabilidad)");

  // Escala numerica del eje Y (profundidad en cm), cada 40 cm
  tft.setTextColor(COLOR_ACENTO);
  for (int cm = 40; y0 + (int)(cm * PX_POR_CM) <= yMax; cm += 40) {
    int ytick = y0 + (int)(cm * PX_POR_CM);
    tft.drawFastHLine(plotX0 - 3, ytick, 3, COLOR_ACENTO);
    tft.setCursor(0, ytick - 3);
    tft.print(cm);
  }

  // Escala horizontal segun el rango de X ya registrado
  float xMin = 1e9f, xMax = -1e9f;
  for (uint8_t i = 0; i < g_trazaCount; i++) {
    float x = g_traza[(g_trazaInicio + i) % TRAZA_MAX_PUNTOS].x_m;
    if (x < xMin) xMin = x;
    if (x > xMax) xMax = x;
  }
  if (g_trazaCount < 2) { xMin = 0; xMax = 1; }
  float rangoX = (xMax - xMin < 0.5f) ? 0.5f : (xMax - xMin);

  // Escala numerica del eje X (metros de avance), 4 marcas
  tft.setTextColor(COLOR_ACENTO);
  for (int i = 0; i <= 4; i++) {
    float valorM = xMin + rangoX * i / 4.0f;
    int xtick = plotX0 + (int)((float)i / 4.0f * (plotX1 - plotX0));
    tft.drawFastVLine(xtick, yMax, 3, COLOR_ACENTO);
    tft.setCursor(constrain(xtick - 8, 0, PANTALLA_ANCHO - 20), yMax + 5);
    tft.print(valorM, 1);
  }

  // Trazado del lecho: primero se calculan los puntos en pixeles, luego
  // se suavizan (Chaikin, 1 pasada) para una curva mas "profesional" en
  // vez de segmentos rectos entre cada medicion.
  static PtoPix crudo[TRAZA_MAX_PUNTOS];
  static PtoPix suave[TRAZA_MAX_PUNTOS * 2 + 2];
  int nCrudo = 0;
  for (uint8_t i = 0; i < g_trazaCount; i++) {
    PuntoTraza p = g_traza[(g_trazaInicio + i) % TRAZA_MAX_PUNTOS];
    int px = plotX0 + (int)(((p.x_m - xMin) / rangoX) * (plotX1 - plotX0));
    int py = constrain((int)(y0 + p.prof_cm * PX_POR_CM), y0, yMax);
    crudo[nCrudo].x = px; crudo[nCrudo].y = py;
    nCrudo++;
  }
  int nSuave = suavizarChaikin(crudo, nCrudo, suave);
  for (int i = 0; i < nSuave - 1; i++) {
    tft.drawLine(suave[i].x, suave[i].y, suave[i+1].x, suave[i+1].y, ST77XX_CYAN);
  }
  // Puntos reales de medicion, encima de la curva suavizada
  for (int i = 0; i < nCrudo; i++) {
    tft.fillCircle(crudo[i].x, crudo[i].y, 2, ST77XX_CYAN);
  }

  // Marcadores actuales (calado y carro/sonda), pegados al borde derecho
  int pxActual = plotX1 - 2;
  if (datos.estado_dispositivos & BIT_US2_OK) {
    int pyCal = constrain((int)(y0 + datos.calado_boya_cm * PX_POR_CM), y0, yMax);
    tft.fillCircle(pxActual, pyCal, 3, ST77XX_BLUE);
  }
  if (datos.estado_dispositivos & BIT_US3_OK) {
    int pyCarro = constrain((int)(y0 + datos.pos_carro_cm * PX_POR_CM), y0, yMax);
    tft.fillCircle(pxActual, pyCarro, 3, ST77XX_WHITE);

    // Flecha de direccion del ascensor, segun la fase activa
    if (datos.estado_fsm == ESTADO_FSM_BAJAR) {
      tft.setTextColor(ST77XX_YELLOW);
      tft.setCursor(pxActual - 30, pyCarro - 4);
      tft.print("v BAJA");
    } else if (datos.estado_fsm == ESTADO_FSM_SUBIR_HOME) {
      tft.setTextColor(ST77XX_YELLOW);
      tft.setCursor(pxActual - 30, pyCarro - 4);
      tft.print("^ SUBE");
    }
  }

  // Leyenda de colores (compacta)
  tft.setTextSize(1);
  tft.fillCircle(6, 122, 2, ST77XX_CYAN);   tft.setTextColor(ST77XX_CYAN);   tft.setCursor(11, 119); tft.print("Lecho");
  tft.fillCircle(46, 122, 2, ST77XX_BLUE);  tft.setTextColor(ST77XX_BLUE);   tft.setCursor(51, 119); tft.print("Calado");
  tft.fillCircle(94, 122, 2, ST77XX_WHITE); tft.setTextColor(ST77XX_WHITE);  tft.setCursor(99, 119); tft.print("Carro");

  // Simbolo de fase activa (sonda midiendo / purgando / tomando muestra)
  uint16_t colorBadge = COLOR_ACENTO;
  bool mostrarBadge = true;
  const char* textoBadge = "";
  switch (datos.estado_fsm) {
    case ESTADO_FSM_LEER_SONDA:        textoBadge = "* SONDA MIDIENDO *";  colorBadge = ST77XX_GREEN;  break;
    case ESTADO_FSM_PURGAR:            textoBadge = "* PURGANDO *";       colorBadge = 0xFD20;         break;
    case ESTADO_FSM_LLENAR_RECIPIENTE: textoBadge = "* TOMANDO MUESTRA *";colorBadge = ST77XX_MAGENTA; break;
    default: mostrarBadge = false; break;
  }
  if (mostrarBadge) {
    int anchoTexto = strlen(textoBadge) * 6;
    tft.fillRect(2, 145, anchoTexto + 6, 10, colorBadge);
    tft.setTextColor(ST77XX_BLACK);
    tft.setCursor(5, 147);
    tft.print(textoBadge);
  } else {
    tft.setTextColor(COLOR_ACENTO);
    tft.setCursor(2, 147);
    tft.print(nombreFaseFsm(datos.estado_fsm));
  }

  tft.setTextColor(COLOR_ACENTO);
  tft.setCursor(2, 157);
  tft.print("BACK=menu OK=lecturas");
}

