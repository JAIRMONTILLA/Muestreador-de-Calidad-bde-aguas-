static unsigned long ultimoEvento = 0;

void botones_iniciar() {
  pinMode(BTN_UP, INPUT_PULLUP);
  pinMode(BTN_DOWN, INPUT_PULLUP);
  pinMode(BTN_OK, INPUT_PULLUP);
  pinMode(BTN_BACK, INPUT_PULLUP);
}

Boton botones_leer() {
  if (millis() - ultimoEvento < DEBOUNCE_MS) return BOTON_NINGUNO;

  Boton resultado = BOTON_NINGUNO;
  if (digitalRead(BTN_UP)   == LOW) resultado = BOTON_ARRIBA;
  else if (digitalRead(BTN_DOWN) == LOW) resultado = BOTON_ABAJO;
  else if (digitalRead(BTN_OK)   == LOW) resultado = BOTON_OK;
  else if (digitalRead(BTN_BACK) == LOW) resultado = BOTON_ATRAS;

  if (resultado != BOTON_NINGUNO) {
    ultimoEvento = millis();
    // ---- DIAGNOSTICO TEMPORAL: quitar estas 2 lineas cuando ya funcione ----
    const char* nombres[] = {"NINGUNO", "ARRIBA", "ABAJO", "OK", "ATRAS"};
    Serial.printf("[BOTON] detectado=%s  (UP=%d DOWN=%d OK=%d BACK=%d)\n",
                  nombres[resultado], digitalRead(BTN_UP), digitalRead(BTN_DOWN),
                  digitalRead(BTN_OK), digitalRead(BTN_BACK));
  }
  return resultado;
}

// ======================================================================
// BUZZER - alertas, encendido, apagado
// ======================================================================
// Implementado por toggle manual del pin (sin usar la API de LEDC), para
// que funcione identico sin importar la version del core ESP32 instalada.
// Sirve tanto para buzzer pasivo (necesita la frecuencia para sonar) como
// para buzzer activo (con oscilador propio: alcanza con ponerlo en HIGH).

void buzzer_iniciar() {
  pinMode(PIN_BUZZER, OUTPUT);
  digitalWrite(PIN_BUZZER, LOW);
}

// Genera un tono de 'frecuencia_hz' durante 'duracion_ms'.
// Buzzer PASIVO: se usa tal cual, la frecuencia define el tono.
// Buzzer ACTIVO: la frecuencia no importa (el buzzer ya oscila solo);
//   si el sonido se escucha entrecortado, cambiar el cuerpo de esta
//   funcion por: digitalWrite(PIN_BUZZER, HIGH); delay(duracion_ms);
//   digitalWrite(PIN_BUZZER, LOW);
void buzzer_tono(uint16_t frecuencia_hz, uint16_t duracion_ms) {
  if (frecuencia_hz == 0) { delay(duracion_ms); return; }
  uint32_t periodo_us = 1000000UL / frecuencia_hz;
  uint32_t medio_us   = periodo_us / 2;
  uint32_t ciclos     = ((uint32_t)duracion_ms * 1000UL) / periodo_us;
  for (uint32_t i = 0; i < ciclos; i++) {
    digitalWrite(PIN_BUZZER, HIGH);
    delayMicroseconds(medio_us);
    digitalWrite(PIN_BUZZER, LOW);
    delayMicroseconds(medio_us);
    yield();   // mismo motivo que en ascensor_homing() del Nodo Boya: un
               // bucle bloqueante largo sin ceder el CPU puede disparar
               // el Task Watchdog del ESP32 y reiniciar la placa a mitad
               // de una melodia -- eso reiniciaria estadoActual de vuelta
               // a UI_VINCULANDO, dando la apariencia de que "nunca avanza"
  }
}

// Dos notas ascendentes cortas -> se usa una vez en setup(), al energizar.
void buzzer_melodia_encendido() {
  buzzer_tono(1000, 90);
  delay(30);
  buzzer_tono(1600, 130);
}

// Dos notas descendentes -> lista para usarla cuando se agregue una rutina
// de apagado/reposo (hoy el firmware no tiene ese punto de entrada; queda
// disponible para llamarla apenas se defina ese flujo).
void buzzer_melodia_apagado() {
  buzzer_tono(1600, 100);
  delay(30);
  buzzer_tono(800, 160);
}

// Tres bips cortos e iguales -> alerta (error_flags != 0 en la telemetria).
void buzzer_melodia_alerta() {
  for (uint8_t i = 0; i < 3; i++) {
    buzzer_tono(2200, 90);
    delay(70);
  }
}

// Bip muy corto de confirmacion al presionar un boton valido.
void buzzer_clic() {
  if (!BUZZER_CLIC_BOTONES) return;
  buzzer_tono(1800, 25);
}

// ---- Melodias estilo "Mario Bros" (motivos cortos, no la cancion completa) ----

// Arpegio ascendente tipo "saliendo del tunel" -- se usa cuando la Boya
// (Nodo 2) se vincula por primera vez y llega el primer dato real.
void buzzer_melodia_vinculado() {
  buzzer_tono(523, 100);   // C5
  buzzer_tono(659, 100);   // E5
  buzzer_tono(784, 100);   // G5
  buzzer_tono(1047, 220);  // C6
}

// "Moneda" -- dos notas cortas, disponible para marcar eventos puntuales
// (por ejemplo, cada vez que se completa un ciclo de muestreo).
void buzzer_melodia_moneda() {
  buzzer_tono(988, 60);    // B5
  buzzer_tono(1319, 200);  // E6
}

// Descenso tipo "game over" -- se usa cuando se PIERDE el enlace con la
// Boya (pasa de conectado a no-conectado).
void buzzer_melodia_sin_conexion() {
  buzzer_tono(400, 150);
  delay(40);
  buzzer_tono(300, 150);
  delay(40);
  buzzer_tono(200, 280);
}

// Dos golpes graves cortos -- fallo puntual (ej. no se pudo enviar un
// comando de protocolo a la Boya).
void buzzer_melodia_falla() {
  buzzer_tono(150, 90);
  delay(60);
  buzzer_tono(150, 90);
}

