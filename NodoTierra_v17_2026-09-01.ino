// ALMACENAMIENTO EN MICROSD  (fuente: almacenamiento.cpp)
// ======================================================================


static bool sdLista = false;
static const char* ARCHIVO_LOG = "/TELEMETRIA.CSV";

bool almacenamiento_iniciar() {
  // El bus SPI (SCK=18, MOSI=23, MISO=19) es compartido con la TFT;
  // SD.begin() se encarga de inicializarlo si aun no lo estaba.
  sdLista = SD.begin(SD_CS);

  if (sdLista && !SD.exists(ARCHIVO_LOG)) {
    File f = SD.open(ARCHIVO_LOG, FILE_WRITE);
    if (f) {
      f.println("timestamp,lat,lon,profundidad_cm,ph,conductividad_us,od_mgL,turbidez_ntu,temp_c,bateria_pct,protocolo,muestras_ciclo,error_flags,paquetes_perdidos");
      f.close();
    }
  }
  return sdLista;
}

bool almacenamiento_ok() {
  return sdLista;
}

void almacenamiento_guardar(const DatosBoya_t& d) {
  if (!sdLista) return;

  File f = SD.open(ARCHIVO_LOG, FILE_APPEND);
  if (!f) {
    sdLista = false;   // se perdio la tarjeta en caliente; se reintentara en el proximo ciclo
    return;
  }
  f.print(d.timestamp);        f.print(',');
  f.print(d.latitud, 6);       f.print(',');
  f.print(d.longitud, 6);      f.print(',');
  f.print(d.profundidad_cm,1); f.print(',');
  f.print(d.ph, 2);            f.print(',');
  f.print(d.conductividad_us,1); f.print(',');
  f.print(d.oxigeno_disuelto,2); f.print(',');
  f.print(d.turbidez_ntu,1);   f.print(',');
  f.print(d.temperatura_c,1);  f.print(',');
  f.print(d.bateria_pct);      f.print(',');
  f.print(d.protocolo_activo); f.print(',');
  f.print(d.muestras_ciclo);   f.print(',');
  f.print(d.error_flags);      f.print(',');
  f.println(d.paquetes_perdidos);
  f.close();
}

