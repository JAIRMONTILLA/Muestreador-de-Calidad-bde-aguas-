// Genera ".", "..", "...", "..", "." (creciente y decreciente en el
// tiempo) -- se usa en vez de un valor cuando ese dato todavia no ha
// llegado de la Boya, para no mostrar un cero o un numero viejo como si
// fuera valido.
String puntosSuspensivosAnimados(uint8_t maxPuntos = 3, uint16_t periodoMs = 350) {
  uint32_t ciclo = (millis() / periodoMs) % (uint32_t)(2 * maxPuntos);
  uint8_t n = (ciclo <= maxPuntos) ? (uint8_t)ciclo : (uint8_t)(2 * maxPuntos - ciclo);
  if (n == 0) n = 1;
  String s;
  for (uint8_t i = 0; i < n; i++) s += '.';
  return s;
}

